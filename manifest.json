{
  "manifest_version": 3,
  "name": "Strava Heatmap for CalTopo [DEV]",
  "description": "Overlay Strava Global Heatmap in iD, GPX.studio, CalTopo, Geotab, and BRouter to reveal popular routes and patterns.",
  "version": "0.15.0.2",
  "homepage_url": "https://github.com/tjasz/strava-heatmap-extension",
  "permissions": [
    "cookies",
    "contextMenus",
    "declarativeNetRequest",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "*://www.strava.com/*",
    "*://content-a.strava.com/*",
    "*://www.openstreetmap.org/*",
    "*://gpx.studio/*",
    "*://caltopo.com/*",
    "*://www.caltopo.com/*",
    "*://tjasz.github.io/*",
    "*://brouter.de/*"
  ],
  "action": {
    "default_popup": ""
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://www.openstreetmap.org/id*"],
      "js": ["src/clients/www.openstreetmap.org/start.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://caltopo.com/*", "*://www.caltopo.com/*"],
      "js": [
        "lib/browser-polyfill.min.js",
        "src/content/inject-client.js",
        "src/content/watch-storage.js",
        "src/content/watch-tile-errors.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["*://tjasz.github.io/geotab/*"],
      "js": [
        "lib/browser-polyfill.min.js",
        "src/content/inject-client.js",
        "src/content/watch-storage.js",
        "src/content/watch-tile-errors.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["*://brouter.de/brouter-web/*"],
      "js": [
        "lib/browser-polyfill.min.js",
        "src/content/inject-client.js",
        "src/content/watch-storage.js",
        "src/content/watch-tile-errors.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://www.openstreetmap.org/id*",
        "*://gpx.studio/app*",
        "*://gpx.studio/*/app*"
      ],
      "js": [
        "lib/browser-polyfill.min.js",
        "src/content/inject-client.js",
        "src/content/watch-storage.js",
        "src/content/watch-tile-errors.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": ["*://www.strava.com/dashboard*", "*://www.strava.com/onboarding*"],
      "js": ["lib/browser-polyfill.min.js", "src/content/strava-redirect.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.strava.com/maps/global-heatmap*"],
      "js": ["lib/browser-polyfill.min.js", "src/content/strava-heatmap.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.strava.com/logout*", "https://www.strava.com/"],
      "js": ["lib/browser-polyfill.min.js", "src/content/strava-logout.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/clients/common/auth.js",
        "src/clients/common/colors.css",
        "src/clients/common/colors.js",
        "src/clients/common/gradient-tiles.js",
        "src/clients/common/hash.js",
        "src/clients/common/layers.js",
        "src/clients/common/palettes.js"
      ],
      "matches": [
        "*://www.openstreetmap.org/*",
        "*://gpx.studio/*",
        "*://caltopo.com/*",
        "*://www.caltopo.com/*",
        "*://tjasz.github.io/*",
        "*://brouter.de/*"
      ]
    },
    {
      "resources": [
        "src/clients/www.openstreetmap.org/id.js",
        "src/clients/www.openstreetmap.org/imagery.js",
        "src/clients/www.openstreetmap.org/index.css",
        "src/clients/www.openstreetmap.org/index.js",
        "src/clients/www.openstreetmap.org/notice.js",
        "src/clients/www.openstreetmap.org/overlays.js",
        "src/clients/www.openstreetmap.org/shortcuts.js",
        "src/clients/www.openstreetmap.org/start.js",
        "src/clients/www.openstreetmap.org/slide/index.js",
        "src/clients/www.openstreetmap.org/slide/algorithm.js",
        "src/clients/www.openstreetmap.org/slide/png.js",
        "src/clients/www.openstreetmap.org/slide/action.js",
        "src/clients/www.openstreetmap.org/slide/tiles.js",
        "icons/slide.svg"
      ],
      "matches": ["*://www.openstreetmap.org/*"]
    },
    {
      "resources": [
        "src/clients/gpx.studio/index.js",
        "src/clients/gpx.studio/index.css"
      ],
      "matches": ["*://gpx.studio/*"]
    },
    {
      "resources": [
        "src/clients/caltopo.com/index.js",
        "src/clients/caltopo.com/index.css",
        "src/clients/caltopo.com/snap.js",
        "src/clients/caltopo.com/snap-network.js",
        "src/clients/caltopo.com/map-sheet.js",
        "src/clients/www.openstreetmap.org/slide/algorithm.js",
        "src/clients/www.openstreetmap.org/slide/png.js",
        "src/clients/www.openstreetmap.org/slide/tiles.js"
      ],
      "matches": ["*://caltopo.com/*", "*://www.caltopo.com/*"]
    },
    {
      "resources": [
        "src/clients/tjasz.github.io/index.js",
        "src/clients/tjasz.github.io/index.css"
      ],
      "matches": ["*://tjasz.github.io/*"]
    },
    {
      "resources": [
        "src/clients/brouter.de/index.js",
        "src/clients/brouter.de/index.css",
        "src/clients/brouter.de/slide.js",
        "src/clients/www.openstreetmap.org/slide/algorithm.js",
        "src/clients/www.openstreetmap.org/slide/png.js",
        "src/clients/www.openstreetmap.org/slide/tiles.js",
        "icons/slide.svg"
      ],
      "matches": ["*://brouter.de/*"]
    }
  ],
  "icons": {
    "48": "icons/icon-48.png"
  },
  "minimum_chrome_version": "88"
}
