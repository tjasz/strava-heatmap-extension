{
  "name": "strava-heatmap-extension",
  "version": "0.0.0",
  "description": "Integrates the Strava Global Heatmap into OpenStreetMap iD, GPX Studio, CalTopo, Geotab, and BRouter.",
  "scripts": {
    "build": "node scripts/build.js",
    "icons": "node scripts/icons.js",
    "promo": "node scripts/promo.js",
    "palettes": "node scripts/palettes.js",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "slide-lab": "node scripts/slide-lab.mjs",
    "slide-lab:check": "node scripts/slide-lab.mjs --check",
    "slide-lab:accept": "node scripts/slide-lab.mjs --accept"
  },
  "author": "Julien Etienne <etienne.julien@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.8.4",
    "commander": "^13.1.0",
    "sharp": "^0.34.5"
  }
}
